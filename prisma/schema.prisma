generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id         String   @id @default(cuid())
  reference  String   @unique
  fullName   String
  dob        DateTime
  sex        String
  phone      String
  email      String?
  address    String
  state      String
  course     String
  courseType String
  branch     String
  createdAt  DateTime @default(now())
}
